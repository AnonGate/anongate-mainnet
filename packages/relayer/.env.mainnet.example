# Ethereum mainnet Silent-send relayer (gitignored as .env.mainnet).
# Copy:  cp .env.mainnet.example .env.mainnet
# Run:   npm run start:mainnet
# Health: http://127.0.0.1:8788/health
#
# Dedicated hot wallet only. Fund with ~0.02–0.03 ETH for gas.
# Never reuse Sepolia / deployer / fee-recipient keys.

RELAYER_PRIVATE_KEY=0xYOUR_MAINNET_RELAYER_KEY
RELAYER_NETWORK=mainnet
RELAYER_RPC=https://ethereum-rpc.publicnode.com
RELAYER_HOST=127.0.0.1
RELAYER_PORT=8788

# Optional: comma-separated browser origins allowed to call this relayer
# RELAYER_CORS_ORIGINS=http://127.0.0.1:5180,http://localhost:5180
