# Sepolia testnet Silent-send relayer (gitignored as .env.sepolia).
# Copy:  cp .env.sepolia.example .env.sepolia
# Run:   npm run start:sepolia
# Health: http://127.0.0.1:8787/health
#
# Dedicated Sepolia hot wallet with a little test ETH.
# Never reuse this key on mainnet.

RELAYER_PRIVATE_KEY=0xYOUR_SEPOLIA_RELAYER_KEY
RELAYER_NETWORK=sepolia
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
RELAYER_HOST=127.0.0.1
RELAYER_PORT=8787

# Optional: comma-separated browser origins allowed to call this relayer
# RELAYER_CORS_ORIGINS=http://127.0.0.1:5180,http://localhost:5180,http://127.0.0.1:5173,http://localhost:5173
