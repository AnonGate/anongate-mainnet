# Dual Silent-send relayers (never commit real keys).
#
# Copy to the matching gitignored file and fill in:
#   .env.sepolia  → Sepolia test wallet, port 8787
#   .env.mainnet  → Mainnet hot wallet, port 8788
#
# Then run both:
#   npm run start:both
#
# Or one network:
#   npm run start:sepolia
#   npm run start:mainnet
#
# Never reuse Sepolia keys on mainnet. Never reuse deployer / fee recipient keys.

# --- Sepolia (.env.sepolia) ---
RELAYER_PRIVATE_KEY=0xYOUR_SEPOLIA_RELAYER_KEY
RELAYER_NETWORK=sepolia
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
RELAYER_HOST=127.0.0.1
RELAYER_PORT=8787

# --- Mainnet (.env.mainnet) ---
# RELAYER_PRIVATE_KEY=0xYOUR_MAINNET_RELAYER_KEY
# RELAYER_NETWORK=mainnet
# RELAYER_RPC=https://ethereum-rpc.publicnode.com
# RELAYER_HOST=127.0.0.1
# RELAYER_PORT=8788

# Optional: comma-separated origins (default allows local Vite on 5173 and 5180)
# RELAYER_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5180,http://localhost:5180
