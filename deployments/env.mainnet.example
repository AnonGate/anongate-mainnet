# Copy to repo-root .env.mainnet.local (gitignored). Never commit secrets.
# All operator addresses must be NEW. Do not reuse Sepolia wallets or contracts.

# Required before --broadcast
I_UNDERSTAND_MAINNET_UNAUDITED=yes
MAINNET_RPC=https://YOUR_MAINNET_RPC
MAINNET_DEPLOYER_PRIVATE_KEY=0xYOUR_NEW_DEPLOYER_KEY
MAINNET_FEE_RECIPIENT=0xYOUR_NEW_FEE_RECIPIENT

# Optional: if omitted, the script derives the deployer address from the key
# MAINNET_DEPLOYER_ADDRESS=0xYOUR_NEW_DEPLOYER_ADDRESS

# Canonical tokens (do not change unless you intend a different asset set)
DAI_ASSET=0x6B175474E89094C44Da98b954EedeAC495271d0F
LUSD_ASSET=0x5f98805A4E8be255a32880FDeC7F6728C6568bA0

# After deploy, Silent-send key goes in packages/relayer/.env.mainnet
# (copy from packages/relayer/.env.mainnet.example — not this file).

# Refuse --broadcast if live gas is above this (gwei). Default 1.
# MAX_GAS_GWEI=1

# Optional Etherscan key for source verify (or use repo-root .env.etherscan)
# ETHERSCAN_API_KEY=
